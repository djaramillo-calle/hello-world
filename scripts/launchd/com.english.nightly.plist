<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <!-- Nightly data sync: Anki (direct read or AnkiConnect), practice recordings from the
       Drive mount, gpodder listening, Intervals.icu push, one commit, push. 21:40 is after
       before-bed cards (20:45) and before sleep (22:00). launchd runs a missed slot at the
       next wake; a powered-off Mac skips it. Installed by scripts/install-automation.sh,
       which substitutes __REPO__ with the clone's absolute path. -->
  <key>Label</key><string>com.english.nightly</string>
  <key>ProgramArguments</key><array>
    <string>/usr/bin/caffeinate</string><string>-i</string>
    <string>/bin/zsh</string><string>-lc</string>
    <string>exec "__REPO__/scripts/coach-sync.sh" --unattended</string>
  </array>
  <key>StartCalendarInterval</key><dict>
    <key>Hour</key><integer>21</integer><key>Minute</key><integer>40</integer>
  </dict>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>StandardOutPath</key><string>/tmp/english-nightly.log</string>
  <key>StandardErrorPath</key><string>/tmp/english-nightly.log</string>
</dict></plist>
